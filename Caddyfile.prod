# Caddyfile.prod — internal Caddy config for the nightscout-lucid container
# This container listens on :80 and is proxied from the goodnumbers Caddy
# at the /clarity path. It serves the Vite SPA with proper HTML5 fallback.

:80 {
    root * /srv

    # Validate access code for nurse endpoint
    @unauthorized_nurse {
        path /clarity/api/nurse/*
        not header X-Nurse-Access-Code "mock-access-code"
    }
    respond @unauthorized_nurse "Unauthorized" 401

    # Route authorized nurse requests to Nightscout
    route /clarity/api/nurse/* {
        uri strip_prefix /clarity/api/nurse
        rewrite * {path}?{query}&token=mock-nurse-token
        reverse_proxy https://mock-nurse-nightscout.example.com {
            header_up Host {upstream_hostport}
        }
    }

    # SPA fallback: unknown paths return index.html under the /clarity sub-path
    try_files {path} /clarity/index.html

    file_server
}
